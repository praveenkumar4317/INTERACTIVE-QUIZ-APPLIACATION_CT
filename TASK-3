#VERILOG CODE
module PipelineProcessor (
    input clk,
    input rst,
    input [7:0] instruction,
    output reg [7:0] result
);

// Define pipeline registers
reg [7:0] IF_ID, ID_EX, EX_MEM, MEM_WB;

always @(posedge clk or posedge rst) begin
    if (rst) begin
        IF_ID  <= 0;
        ID_EX  <= 0;
        EX_MEM <= 0;
        MEM_WB <= 0;
    end else begin
        IF_ID  <= instruction;  // Fetch
        ID_EX  <= IF_ID;        // Decode
        EX_MEM <= ID_EX + 1;    // Execute (simple example)
        MEM_WB <= EX_MEM;       // Write-back
        result <= MEM_WB;
    end
end

endmodule
